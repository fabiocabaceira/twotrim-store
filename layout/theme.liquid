<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://cdn.shopify.com">
  <script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a href="#main" class="skip-link">Skip to content</a>

  {% section 'free-shipping-banner' %}
  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}
  {% section 'exit-intent' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
