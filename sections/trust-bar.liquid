<div class="trust-bar">
  <div class="trust-bar__inner">
    {% for block in section.blocks %}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon">{{ block.settings.icon }}</span>
        <span>{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping Over €50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "🚚", "text": "Free Shipping Over €50" } },
        { "type": "item", "settings": { "icon": "↩️", "text": "Easy 30-Day Returns" } },
        { "type": "item", "settings": { "icon": "🔒", "text": "Secure Checkout" } },
        { "type": "item", "settings": { "icon": "⭐", "text": "5,000+ Happy Fans" } }
      ]
    }
  ]
}
{% endschema %}
