<section class="section">
  <div class="container">
    <p class="heading-sm text-center">{{ section.settings.kicker }}</p>
    <h2 class="heading-lg text-center" style="margin-top:8px;margin-bottom:32px">{{ section.settings.title }}</h2>

    <div class="grid grid--3">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="clubs-grid__item" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name }}" loading="lazy">
          {% else %}
            <span style="font-size:48px">⚽</span>
          {% endif %}
          <span class="clubs-grid__name">{{ block.settings.name }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Clubs",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop by Club"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Find Your Kit"
    }
  ],
  "blocks": [
    {
      "type": "club",
      "name": "Club",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Club name",
          "default": "Benfica"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Club badge / image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Clubs",
      "blocks": [
        { "type": "club", "settings": { "name": "Benfica" } },
        { "type": "club", "settings": { "name": "FC Porto" } },
        { "type": "club", "settings": { "name": "Sporting CP" } },
        { "type": "club", "settings": { "name": "Real Madrid" } },
        { "type": "club", "settings": { "name": "Barcelona" } },
        { "type": "club", "settings": { "name": "Manchester United" } },
        { "type": "club", "settings": { "name": "Portugal 🇵🇹" } },
        { "type": "club", "settings": { "name": "Brazil 🇧🇷" } },
        { "type": "club", "settings": { "name": "Argentina 🇦🇷" } }
      ]
    }
  ]
}
{% endschema %}
