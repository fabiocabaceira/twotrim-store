<section class="section">
  <div class="container page-content text-center">
    <h1 class="heading-lg">{{ section.settings.title }}</h1>
    <p class="text-muted" style="margin-top:8px;margin-bottom:32px">{{ section.settings.subtitle }}</p>

    <div style="max-width:480px;margin:0 auto">
      {% form 'contact', class: 'newsletter__form' %}
        {% if form.posted_successfully? %}
          <p style="color:var(--color-accent);font-weight:600;margin-bottom:16px">Message sent! We'll get back to you within 24 hours.</p>
        {% endif %}

        <input type="text" name="contact[name]" class="newsletter__input" placeholder="Your name" required>
        <input type="email" name="contact[email]" class="newsletter__input" placeholder="Your email" required autocomplete="email">
        <select name="contact[topic]" class="newsletter__input" style="appearance:auto">
          <option value="">Select a topic...</option>
          <option value="Order Issue">Order Issue</option>
          <option value="Sizing Help">Sizing Help</option>
          <option value="Returns">Returns</option>
          <option value="Shipping Question">Shipping Question</option>
          <option value="Other">Other</option>
        </select>
        <textarea name="contact[body]" class="newsletter__input" rows="4" placeholder="Your message" required style="resize:vertical;min-height:120px"></textarea>
        <button type="submit" class="btn btn--primary btn--full">Send Message</button>
      {% endform %}
    </div>

    <div style="margin-top:40px">
      <p class="text-muted" style="font-size:14px">Or DM us directly:</p>
      <p style="margin-top:8px;font-size:15px;font-weight:600">Instagram: @twotrim</p>
      <p style="font-size:14px;color:var(--color-text-muted);margin-top:4px">We usually reply within a few hours</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Question about sizing, shipping, or your order? We're here to help."
    }
  ]
}
{% endschema %}
