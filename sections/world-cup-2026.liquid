{% comment %}
  ============================================================
  Two Trim — World Cup 2026 Collection Section
  ============================================================
  Displays 6 national teams in a grid (3-col desktop, 2-col mobile).
  Each card shows home + away kit images side by side, team info,
  supplier badge, description, and a Shop Now CTA.

  Fully customisable from the Shopify Theme Editor:
  - Section-level: kicker, title, subtitle, accent colour override
  - Block-level (per team): name, flag, supplier, description,
    home/away images, collection link, visibility toggle

  Images: Upload kit images to Shopify Files, then select them
  via the image_picker in the theme editor. Alternatively, use
  product metafields (namespace: twotrim.kit_home / twotrim.kit_away)
  to connect images to products programmatically.
  ============================================================
{% endcomment %}

{{ 'wc-2026.css' | asset_url | stylesheet_tag }}

{% if section.settings.enabled %}
<section class="wc-section" id="world-cup-2026">
  <div style="max-width:1200px;margin:0 auto;padding:0 16px">

    {%- comment -%} --- Section header --- {%- endcomment -%}
    <div class="wc-header">
      {% if section.settings.kicker != blank %}
        <p class="wc-header__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      <h2 class="wc-header__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="wc-header__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    {%- comment -%} --- Teams grid --- {%- endcomment -%}
    <div class="wc-grid">
      {% for block in section.blocks %}
        {% if block.settings.visible %}
          <div class="wc-card" {{ block.shopify_attributes }}>

            {%- comment -%} Kit images: home (left) + away (right) {%- endcomment -%}
            <div class="wc-card__kits">
              {%- comment -%} Home kit {%- endcomment -%}
              <div class="wc-card__kit">
                <span class="wc-card__kit-badge wc-card__kit-badge--home">Home</span>
                {% if block.settings.home_image %}
                  <img
                    src="{{ block.settings.home_image | image_url: width: 480 }}"
                    alt="{{ block.settings.name }} Home Kit 2026"
                    loading="lazy"
                    width="480"
                    height="640"
                  >
                {% else %}
                  {%- comment -%} Placeholder when no image uploaded yet {%- endcomment -%}
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--color-surface-alt,#1a1a1a)">
                    👕
                  </div>
                {% endif %}
              </div>

              {%- comment -%} Away kit {%- endcomment -%}
              <div class="wc-card__kit">
                <span class="wc-card__kit-badge wc-card__kit-badge--away">Away</span>
                {% if block.settings.away_image %}
                  <img
                    src="{{ block.settings.away_image | image_url: width: 480 }}"
                    alt="{{ block.settings.name }} Away Kit 2026"
                    loading="lazy"
                    width="480"
                    height="640"
                  >
                {% else %}
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--color-surface-alt,#1a1a1a)">
                    👕
                  </div>
                {% endif %}
              </div>
            </div>

            {%- comment -%} Card body: team info + CTA {%- endcomment -%}
            <div class="wc-card__body">
              <div class="wc-card__team">
                {% if block.settings.flag != blank %}
                  <span class="wc-card__flag">{{ block.settings.flag }}</span>
                {% endif %}
                <span class="wc-card__name">{{ block.settings.name }}</span>
              </div>

              {% if block.settings.supplier != blank %}
                <span class="wc-card__supplier">{{ block.settings.supplier }}</span>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="wc-card__desc">{{ block.settings.description }}</p>
              {% endif %}

              {% if block.settings.collection_link != blank %}
                <a href="{{ block.settings.collection_link }}" class="wc-card__cta">
                  Shop Now
                  <span class="wc-card__cta-arrow">→</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}

{% schema %}
{
